      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Reactive and Sensor-Based Planning; Path Planning for Multiple Mobile Robots or Agents; Motion and Path Planning; Multi-Robot Systems</pdf:Keywords>
